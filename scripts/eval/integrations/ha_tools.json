  "description": "Turns on/opens/presses a device or entity. For locks, this performs a 'lock' action. Use for requests like 'turn on', 'activate', 'enable', or 'lock'.",
  "input_schema": {
   "type": "object",
   "properties": {
    "area": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "floor": {
     "type": "string"
    },
    "domain": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "device_class": {
     "type": "array",
     "items": {
      "enum": [
       "identify",
       "restart",
       "update",
