# Home AI Agent — environment contract
#
# Setup:
#   1. cp .env.example .env
#   2. Fill in POSTGRES_PASSWORD (required, no default).
#   3. Fill in RENDER_GID / VIDEO_GID for *this* host:
#        getent group render | cut -d: -f3
#        getent group video  | cut -d: -f3
#   4. Adjust LAN_SUBNET to match your actual network (check with `ip -4 addr show`).
#
# Every variable below is consumed by a specific service — see the "Consumed by"
# comment on each line. Full contract: docs/ARCHITECTURE.md.

# --- Identity / permissions ---------------------------------------------------

# UID the agent-server process and exec containers run as; also chowns the
# workspace directory. Consumed by: agent-server, code-exec-manager, setup-workspace.sh
HOMEAI_UID=1000

# GID counterpart to HOMEAI_UID. Consumed by: agent-server, code-exec-manager, setup-workspace.sh
HOMEAI_GID=1000

# --- Workspace -------------------------------------------------------------

# Host path bind-mounted into agent-server (FilesystemBackend root) and every
# code-exec container (rw). Consumed by: compose bind mounts, code-exec-manager
WORKSPACE_DIR=/srv/homeai/workspace

# --- Model runner ------------------------------------------------------------

# GGUF filename inside services/model-runner/models/. Consumed by: model-runner
# This repo publishes no K-quants (see services/model-runner/fetch-model.sh);
# Q8_0 is the default — see the "Quant benchmark" section in
# docs/ARCHITECTURE.md for the full data and rationale.
MODEL_FILE=gemma-4-26B-A4B-it-Q8_0.gguf

# Context window (tokens) passed to llama-server. Consumed by: model-runner
MODEL_CTX_SIZE=32768

# Extra flags appended verbatim to the llama-server command line. Consumed by: model-runner
# --verbose is needed because llama-server's default log verbosity (3)
# hides the "load_tensors: offloaded N/N layers to GPU" / "Vulkan0 model buffer size"
# lines that prove GPU offload. --reasoning-budget 0 disables Gemma 4's default
# "auto" thinking mode, which otherwise burns the whole token budget on hidden
# <|channel>thought content before any visible answer — without it, short
# max_tokens completions (e.g. the acceptance-check "PONG" request) come back
# with an empty message.content.
MODEL_EXTRA_ARGS=--verbose --reasoning-budget 0

# Model name reported to/used by the OpenAI-compatible client. Consumed by: agent-server
MODEL_NAME=gemma-4-26b-a4b-it

# GID of the host's `render` group, so model-runner can access /dev/dri/renderD128.
# Find with: getent group render | cut -d: -f3
# Consumed by: model-runner (group_add)
RENDER_GID=

# GID of the host's `video` group, so model-runner can access /dev/dri/card*.
# Find with: getent group video | cut -d: -f3
# Consumed by: model-runner (group_add)
VIDEO_GID=

# --- Postgres ----------------------------------------------------------------

# Consumed by: postgres, agent-server
POSTGRES_USER=homeai

# REQUIRED — no default on purpose. Set a real value before `docker compose up`.
# Consumed by: postgres, agent-server
POSTGRES_PASSWORD=

# Consumed by: postgres, agent-server
POSTGRES_DB=homeai

# --- Service-to-service URLs (internal docker network, homeai-net) -----------

# Consumed by: agent-server
MODEL_BASE_URL=http://model-runner:8080/v1

# Consumed by: agent-server
EXEC_MANAGER_URL=http://code-exec-manager:8090

# --- Code execution ------------------------------------------------------------

# Minutes of inactivity before an idle exec container is reaped. Consumed by: code-exec-manager
EXEC_IDLE_MINUTES=30

# Default per-command timeout (seconds) if the caller doesn't override it.
# Consumed by: code-exec-manager, agent-server (execute_code tool)
EXEC_DEFAULT_TIMEOUT_S=120

# --- Backup ------------------------------------------------------------------

# Host path for workspace mirror + Postgres dumps. Consumed by:
# backup-workspace.sh, install-backup-timer.sh
BACKUP_DIR=/srv/homeai/backups

# --- Networking ------------------------------------------------------------

# LAN CIDR allowed to reach port 80. Consumed by: setup-ufw.sh (ufw rule + DOCKER-USER rule)
LAN_SUBNET=192.168.1.0/24

# Base URL the native (iOS/Android) app uses to reach the API/WS. Web build uses
# same-origin instead. Consumed by: frontend (native only)
EXPO_PUBLIC_API_HOST=http://homeai.local
