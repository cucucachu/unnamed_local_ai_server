{
	# HTTP stays first-class (Expo Go + phones without the CA). Do not
	# auto-redirect :80 -> :443 — that would break those clients.
	auto_https disable_redirects
}

# Session check for every authenticated route (docs/PLATFORM.md §3): the
# platform validates the cookie/bearer and answers 200 with the identity JWT
# (copied onto the proxied request) or 401 (returned to the client as-is).
(authenticated) {
	forward_auth platform:8100 {
		uri /internal/auth/verify
		copy_headers X-HomeAI-Identity
		# The subrequest carries the client's headers; on a WebSocket
		# upgrade uvicorn would treat the verify call itself as a WS
		# handshake and reject it (403). The upgrade still reaches the
		# upstream: these only apply to the verify request.
		header_up -Connection
		header_up -Upgrade
	}
}

(app) {
	encode gzip

	# Only forward_auth may set the identity. Top-level request_header sorts
	# before every handle block, so a client-supplied copy is gone before
	# any route (authenticated or not) sees the request.
	request_header -X-HomeAI-Identity

	# Same trust model as XFF: strip any client X-HomeAI-Via, then Caddy
	# sets it when the TCP peer is the wireguard compose service (snippet
	# generated at start from Docker DNS — see entrypoint). Do not add
	# trusted_proxies or PROXY protocol on :80/:443.
	request_header -X-HomeAI-Via
	import /etc/caddy/via.caddy

	# Login, setup, invite accept, status: unauthenticated by design.
	handle /api/auth/* {
		reverse_proxy platform:8100
	}
	handle /api/health {
		reverse_proxy agent-server:8000
	}
	handle /api/platform/* {
		import authenticated
		reverse_proxy platform:8100
	}
	handle /ws/platform/* {
		import authenticated
		reverse_proxy platform:8100
	}
	handle /api/* {
		import authenticated
		reverse_proxy agent-server:8000
	}
	handle /ws/* {
		import authenticated
		reverse_proxy agent-server:8000
	}
	# The app sandbox runtime per SDK version (static; no data in it). Hosts
	# fetch it and inline it into the sandbox document; no SPA fallback.
	handle /app-runtime/* {
		root * /srv
		header Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

:80 {
	# Same file scripts/export-ca.sh copies to ${BACKUP_DIR}/homeai-root-ca.crt.
	# Served over HTTP on a trusted LAN so a device can fetch it *before*
	# it trusts the CA (see docs/NETWORKING.md). The CA private key is
	# never served.
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	import app
}

https://homeai.local {
	tls internal
	import app
}

# Optional ACME DNS-01 site, written at container start when HOMEAI_DOMAIN
# is a valid hostname (infra/caddy/entrypoint.sh). Empty when unset — do
# not put `https://{$HOMEAI_DOMAIN}` here; an empty site address is invalid.
# homeai.local above always stays; :80 is never redirected and has no HSTS.
import /etc/caddy/domain.caddy
