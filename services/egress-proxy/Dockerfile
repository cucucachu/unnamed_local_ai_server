# M7-02: the single, deliberately-narrow egress chokepoint (docs/ARCHITECTURE.md
# §5 "Security model") - terminates TLS with its own CA (mitmproxy generates
# one on first start, see docker-compose.yml's `egress-proxy-ca` volume
# comment) so `policy.py` can see the real method/host/path of HTTPS
# requests, not just a `CONNECT host:443` tunnel.
#
# Pinned by digest (multi-platform manifest-list digest, resolved via the
# Docker Hub v2 API for the `mitmproxy/mitmproxy:12` tag - this sandbox has
# no local `docker` daemon to run `docker inspect`/`buildx imagetools
# inspect` against, the usual way other Dockerfiles in this repo resolve
# their pin, e.g. services/model-runner/Dockerfile's own comment). Re-verify
# with `docker buildx imagetools inspect mitmproxy/mitmproxy:12` (or `docker
# pull` + `docker inspect --format='{{index .RepoDigests 0}}'`) once this
# runs somewhere with real registry+docker access, the same way
# model-runner's own pin was confirmed.
FROM mitmproxy/mitmproxy@sha256:00b77b5d8804c8ad18cb6caefbf9d5849e895e8986c5ce011f4ae30f4385962f
# was: mitmproxy/mitmproxy:12 (12.2.3 at pin time)

WORKDIR /app

COPY policy.py ./policy.py

# CA material persists in a named volume mounted at ~/.mitmproxy (compose's
# `egress-proxy-ca:/home/mitmproxy/.mitmproxy` - the upstream image's `HOME`
# for its non-root `mitmproxy` user, confirmed via the base image's own
# release/docker/Dockerfile: `useradd -mU mitmproxy` +
# `mkdir /home/mitmproxy/.mitmproxy`) - generated by mitmproxy itself on
# first start, not baked in here. See docs/ARCHITECTURE.md §5 for how
# M7-03/M7-04 mount the same volume read-only and trust
# `mitmproxy-ca-cert.pem` from it.
#
# Deliberately NOT overriding ENTRYPOINT: the base image's own
# `docker-entrypoint.sh` is what drops from root to the non-root
# `mitmproxy` user (via `gosu`, after `usermod`-ing that user's uid/gid to
# match whatever already owns the mounted `~/.mitmproxy` volume) and sets
# `HOME=/home/mitmproxy` before actually exec'ing the tool named in CMD's
# first argument - replacing it here would skip that privilege-drop and
# CA-ownership handling entirely and run mitmdump as root instead.
#
# --listen-port 8080: matches docker-compose.yml's internal port (no
# published port - only reachable from other containers on homeai-net /
# homeai-internal, never from the host or LAN).
# -s /app/policy.py: the addon implementing the method allowlist +
# destination guard + body-size cap (this ticket's actual policy).
# --set stream_large_bodies=1m: CLI-level streaming for any response over
# 1 MB - the addon's own `responseheaders()` hook additionally sets
# `flow.response.stream = True` unconditionally for anything that passes
# the size check, so bodies are never fully buffered in memory regardless
# of size, and the CLI flag is redundant-but-harmless belt-and-suspenders
# for the same intent.
CMD ["mitmdump", "--listen-port", "8080", "-s", "/app/policy.py", "--set", "stream_large_bodies=1m"]
