# Home AI Agent — environment contract
#
# Setup:
#   1. cp .env.example .env
#   2. Fill in POSTGRES_PASSWORD (required, no default).
#   3. Fill in RENDER_GID / VIDEO_GID for *this* host:
#        getent group render | cut -d: -f3
#        getent group video  | cut -d: -f3
#   4. Adjust LAN_SUBNET to match your actual network (check with `ip -4 addr show`).
#
# Every variable below is consumed by a specific service — see the "Consumed by"
# comment on each line. Full contract: docs/ARCHITECTURE.md.

# --- Identity / permissions ---------------------------------------------------

# UID the agent-server process and exec containers run as; also chowns the
# workspace directory. Consumed by: agent-server, code-exec-manager, setup-workspace.sh
HOMEAI_UID=1000

# GID counterpart to HOMEAI_UID. Consumed by: agent-server, code-exec-manager, setup-workspace.sh
HOMEAI_GID=1000

# --- Workspace -------------------------------------------------------------

# Host path bind-mounted into agent-server (FilesystemBackend root) and every
# code-exec container (rw). Consumed by: compose bind mounts, code-exec-manager
WORKSPACE_DIR=/srv/homeai/workspace

# --- Model runner ------------------------------------------------------------

# GGUF filename inside services/model-runner/models/. Consumed by: model-runner
# This repo publishes no K-quants (see services/model-runner/fetch-model.sh);
# Q8_0 is the default — see the "Quant benchmark" section in
# docs/ARCHITECTURE.md for the full data and rationale.
MODEL_FILE=gemma-4-26B-A4B-it-Q8_0.gguf

# Context window (tokens) passed to llama-server. Consumed by: model-runner
MODEL_CTX_SIZE=32768

# Extra flags appended verbatim to the llama-server command line. Consumed by: model-runner
# --verbose is needed because llama-server's default log verbosity (3)
# hides the "load_tensors: offloaded N/N layers to GPU" / "Vulkan0 model buffer size"
# lines that prove GPU offload. --reasoning-format deepseek streams thought
# tokens as delta.reasoning_content before delta.content (M8-06 GO; shipped
# as the live config by M8-07). Thinking itself is a per-request decision
# via chat_template_kwargs.enable_thinking, bound from
# SettingsStore.thinking_enabled (default false) — there is no
# --reasoning-budget cap. See docs/ARCHITECTURE.md §4 and
# docs/TOOL_CALLING.md's M8-06 section.
MODEL_EXTRA_ARGS=--verbose --reasoning-format deepseek

# Model name reported to/used by the OpenAI-compatible client. Consumed by: agent-server
MODEL_NAME=gemma-4-26b-a4b-it

# GID of the host's `render` group, so model-runner can access /dev/dri/renderD128.
# Find with: getent group render | cut -d: -f3
# Consumed by: model-runner (group_add)
RENDER_GID=

# GID of the host's `video` group, so model-runner can access /dev/dri/card*.
# Find with: getent group video | cut -d: -f3
# Consumed by: model-runner (group_add)
VIDEO_GID=

# --- Postgres ----------------------------------------------------------------

# Consumed by: postgres, agent-server
POSTGRES_USER=homeai

# REQUIRED — no default on purpose. Set a real value before `docker compose up`.
# Consumed by: postgres, agent-server
POSTGRES_PASSWORD=

# Consumed by: postgres, agent-server
POSTGRES_DB=homeai

# --- Service-to-service URLs (internal docker network, homeai-net) -----------

# Consumed by: agent-server
MODEL_BASE_URL=http://model-runner:8080/v1

# Consumed by: agent-server
EXEC_MANAGER_URL=http://code-exec-manager:8090

# Where agent-server's web_search/web_fetch tools (M7-05) send every
# request - never the public internet or egress-proxy directly; web-fetch
# is the only thing that talks to those. Consumed by: agent-server
WEB_FETCH_URL=http://web-fetch:8000

# Tool-side cap (characters) on web_fetch's returned text, independent of
# (and on top of) web-fetch's own FETCH_MAX_TEXT_CHARS server-side cap.
# Consumed by: agent-server
WEB_FETCH_TOOL_MAX_CHARS=30000

# --- Code execution ------------------------------------------------------------

# Minutes of inactivity before an idle exec container is reaped. Consumed by: code-exec-manager
EXEC_IDLE_MINUTES=30

# Default per-command timeout (seconds) if the caller doesn't override it.
# Consumed by: code-exec-manager, agent-server (execute_code tool)
EXEC_DEFAULT_TIMEOUT_S=120

# --- Backup ------------------------------------------------------------------

# Host path for workspace mirror + Postgres dumps + the exported Caddy
# root CA (`homeai-root-ca.crt`, via scripts/export-ca.sh). Consumed by:
# backup-workspace.sh, install-backup-timer.sh, export-ca.sh
BACKUP_DIR=/srv/homeai/backups

# --- Egress proxy (M7-02) ---------------------------------------------------

# Max response body size (bytes) the egress proxy allows through, checked
# against the upstream response's Content-Length in policy.py's
# responseheaders() hook; the flow is killed if it's exceeded. 20 MB default.
# Consumed by: egress-proxy
EGRESS_MAX_BYTES=20971520

# --- Web fetch (M7-03) -------------------------------------------------------

# Where web-fetch sends every outbound request - never the public internet
# directly. Consumed by: web-fetch
EGRESS_PROXY_URL=http://egress-proxy:8080

# Per-request timeout (seconds) for the whole fetch (connect + read),
# passed straight to the httpx client. Consumed by: web-fetch
FETCH_TIMEOUT_S=20

# Hard cap (bytes) on a fetched response body - aborted mid-stream with a
# 413 if exceeded, checked against actual bytes read rather than trusting a
# declared Content-Length. Consumed by: web-fetch
FETCH_MAX_BYTES=5000000

# Hard cap (characters) on the extracted text returned to the caller - the
# result is truncated (with `truncated: true`) rather than rejected.
# Consumed by: web-fetch
FETCH_MAX_TEXT_CHARS=40000

# Max HTTP redirects followed before giving up. Consumed by: web-fetch
FETCH_MAX_REDIRECTS=5

# Where web-fetch sends every /search request - the internal SearXNG
# instance, never the public internet directly. Consumed by: web-fetch
SEARXNG_URL=http://searxng:8080

# --- SearXNG (M7-04) ---------------------------------------------------------

# Signs SearXNG's Flask session cookie/CSRF token. Generate with:
#   openssl rand -hex 32
# NOTE (see services/searxng/settings.yml's own `server.secret_key`
# comment for the full explanation): the pinned searxng/searxng image only
# reads this env var to patch a settings.yml it generates itself on first
# boot; this repo mounts its own settings.yml (with GET-only engines + JSON
# format already configured), so that bootstrap path never runs and this
# value is currently NOT what actually protects the running instance's
# secret_key. Still set here for consistency with this repo's
# every-secret-is-an-env-var convention and so a future templating
# entrypoint could pick it up. Consumed by: searxng (compose environment
# only, not yet by the running settings.yml)
SEARXNG_SECRET=

# --- Networking ------------------------------------------------------------

# LAN CIDR allowed to reach ports 80 and 443. Consumed by: setup-ufw.sh (ufw rules + DOCKER-USER rules)
LAN_SUBNET=192.168.1.0/24

# Base URL the native (iOS/Android) app uses to reach the API/WS. Web build uses
# same-origin instead (and derives ws:// vs wss:// from location.protocol).
# Use https://homeai.local once the phone trusts the Caddy local CA
# (scripts/export-ca.sh + docs/NETWORKING.md). HTTP stays valid — Expo Go
# and devices without the CA should keep http://. Consumed by: frontend (native only)
EXPO_PUBLIC_API_HOST=http://homeai.local
