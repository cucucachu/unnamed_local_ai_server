  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo start --android --go",
    "android:dev": "expo run:android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "check:platform": "node scripts/check-platform.mjs",
    "test": "npm run check:platform && jest"
