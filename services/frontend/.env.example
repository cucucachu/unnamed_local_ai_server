# Only read for native (Expo Go / standalone builds) — the web build is
# always same-origin (Caddy serves the SPA and proxies /api + /ws itself),
# so this has no effect on `npx expo export --platform web` / the Docker
# image. See lib/api.ts's apiBase()/wsUrl().
#
# cp .env.example .env, then adjust if homeai.local doesn't resolve on your
# phone (see "Run on your phone" below) — use the host's LAN IP instead,
# e.g. EXPO_PUBLIC_API_HOST=http://192.168.1.42
EXPO_PUBLIC_API_HOST=http://homeai.local
